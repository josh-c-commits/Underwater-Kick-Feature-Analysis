# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Source/sample videos and their derived outputs -- local data, not code
*.mov
*.mp4

# Derived per-clip artifacts (boxes, kinematics, contact sheets): all
# reproducible from data/ plus a calibration, so not worth versioning.
out/

# NOT ignored: data/calibrations/*.json. Those are hand-clicked reference
# marks -- small, slow to recreate, and genuinely input rather than output.
!data/calibrations/

# macOS
.DS_Store
